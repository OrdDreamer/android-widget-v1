        "selector": "JSXOpeningElement[name.name='ValueReadout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent)$/]",
        "message": "<ValueReadout> tone must be one of 'neutral' | 'accent'."
      }
    ]
  },
